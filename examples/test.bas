240 PRINT "--- 4. TEST IF / THEN / ELSE ---"
250 LET X = 5
260 IF X > 2 THEN LET RES$ = "X > 2 EST VRAI" ELSE LET RES$ = "X > 2 EST FAUX"
270 PRINT RES$
280 IF X = 10 THEN GOTO 320
290 PRINT "X N'EST PAS EGAL A 10 (SAUT EVITE)"
300 GOTO 330
310 REM CETTE LIGNE NE DOIT PAS S'AFFICHER
320 PRINT "ERREUR GOTO"

330 REM --- 5. TEST INPUT ---
