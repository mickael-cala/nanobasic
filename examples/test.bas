10 REM ==========================================
20 REM TEST DE NANOBASIC
30 REM ==========================================
40 PRINT "--- 1. TEST VARIABLES ET TYPES ---"
50 LET NOM$ = "NanoBasic"
60 LET VERSION = 1.0
70 PRINT NOM$
80 PRINT VERSION

90 REM --- 2. CALCULS ET PRIORITES ---
100 PRINT "--- 2. CALCULS ARITHMETIQUES ---"
110 LET A = 2 + 3 * 4
120 LET B = (2 + 3) * 4
130 LET C = 2 ^ 3
